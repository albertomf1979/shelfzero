{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shelfzero",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shelfzero",
      // Reemplaza con el id real tras `npm run db:create` (solo necesario para desplegar).
      // En desarrollo local se usa una base de datos SQLite emulada y este valor no importa.
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ]
}
